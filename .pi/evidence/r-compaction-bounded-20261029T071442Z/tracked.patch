+def test_analysis_generation_rejects_late_reconcile_and_recovers(tmp_path):
+    import threading
+    from concurrent.futures import ThreadPoolExecutor
+
+    with _open(tmp_path) as db, ThreadPoolExecutor(max_workers=1) as executor:
+        original = SAMPLE_V1
+        replacement = SAMPLE_V1_EDITED
+        db.reconcile_file("src/m.py", original)
+        symbol_id = "src.m:alpha"
+        paused, release = threading.Event(), threading.Event()
+
+        def old_analysis():
+            with db.analysis_pass():
+                assert db.reconcile_file("src/m.py", original).is_noop
+                paused.set()
+                assert release.wait(5)
+                assert db.reconcile_file("src/m.py", original).is_noop
+                db.mark_symbol_clean(symbol_id)
+                db.mark_symbol_error(symbol_id)
+                db.write_mutant_result(symbol_id, _make_mutant(2), _make_result(), "old", "old")
+                assert db.get_state(symbol_id) == STATE_DIRTY
+            # A raised pass also releases its thread-local publication fence.
+            with pytest.raises(ValueError, match="user failure"):
+                with db.analysis_pass():
+                    raise ValueError("user failure")
+            db.mark_symbol_clean(symbol_id)
+
+        worker = executor.submit(old_analysis)
+        try:
+            assert paused.wait(5)
+            db.reconcile_file("src/m.py", "")
+            db.reconcile_file("src/m.py", replacement)
+            assert set(db.get_dirty_symbols()) == set(extract_symbols("src/m.py", replacement))
+            db.write_mutant_result(symbol_id, _make_mutant(2), _make_result(), "new", "new")
+            retained = db._execute("SELECT * FROM mutants").fetchall()
+        finally:
+            release.set()
+            worker.result(timeout=10)
+        assert db.get_symbol(symbol_id).source_hash == extract_symbols("src/m.py", replacement)[symbol_id].source_hash
+        assert db._execute("SELECT * FROM mutants").fetchall() == retained
+        assert db.get_state(symbol_id) == STATE_CLEAN
