+         target = tmp_path / f"{name}.py"
+         target.write_text(source)
+         points = find_mutation_points(source, str(target), name)
+         point = next(p for p in points if p.node_type == "BinOp")
+         return (
+             Mutant(point=point, replacement_op="Sub", mutant_id=0),
