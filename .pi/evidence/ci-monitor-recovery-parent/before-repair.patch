+@pytest.mark.parametrize("remove", [False, True])
+def test_first_analysis_zero_coverage_change_fences_real_publication(tmp_path, monkeypatch, remove):
+    import threading
+    from concurrent.futures import ThreadPoolExecutor
+    import pytest_leela.engine as engine_module
+
+    daemon, _, _ = _lifecycle_daemon(tmp_path, monkeypatch)
+    source = tmp_path / "src/identity.py"
+    source.write_text("def identity(value):\n    return value\n")
+    test = tmp_path / "tests/test_identity.py"
+    test.write_text("from identity import identity\ndef test_identity():\n    assert identity(1) == 1\n")
+    paused, release = threading.Event(), threading.Event()
+    actual_runner = engine_module.run_tests_for_mutant
+    runner_results = []
+
+    def pause_actual_result(*args, **kwargs):
+        result = actual_runner(*args, **kwargs)
+        if not paused.is_set():
+            runner_results.append(result)
+            paused.set()
+            assert release.wait(15)
+        return result
+
+    monkeypatch.setattr(engine_module, "run_tests_for_mutant", pause_actual_result)
+    with IndexDB(tmp_path / "first.db") as db, ThreadPoolExecutor(max_workers=1) as poller:
+        daemon._initial_build(db)
+        assert not db._execute("SELECT * FROM mutants").fetchall()
+        daemon._maybe_spawn_reanalysis(db)
+        assert paused.wait(15), daemon.out.getvalue()
+        if remove:
+            test.unlink()
+        else:
+            test.write_text("def test_idle():\n    assert True\n")
+        poll = poller.submit(daemon._scan_for_changes, db)
+        try:
+            # Future.result both bounds scan completion and propagates its
+            # actual exception; no callback catch can conceal a failed scan.
+            poll.result(timeout=15)
+            # The input signature is consumed before the old runner is released.
+            assert str(test) not in daemon._test_signatures if remove else daemon._test_signatures[str(test)] == daemon._signature(test.read_bytes())
+        finally:
+            release.set()
+            _join_daemon_worker(daemon)
+        # No consumer row existed when the change was scanned. The old result
+        # must therefore remain fenced, not become clean/current evidence.
+        assert runner_results
+        assert not db._execute("SELECT * FROM mutants").fetchall()
+        assert db.get_dirty_symbols()
+        assert daemon._last_change_at != daemon._last_reanalysis_at
+        daemon._maybe_spawn_reanalysis(db)
+        _join_daemon_worker(daemon)
+        if remove:
+            assert db.get_dirty_symbols(), "deleted-test input was fabricated clean"
+        else:
+            rows = db._execute("SELECT details FROM mutants").fetchall()
+            assert rows
+            assert all("test_idle" in raw for (raw,) in rows)
+
+
